# ==============================================================================
# NexLead - Environment Variables Example
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Application Tier)
# ------------------------------------------------------------------------------
PROJECT_NAME="NexLead API"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Data Tier (MySQL 8.4)
DATABASE_URL="mysql+pymysql://root:password@127.0.0.1:3306/lead_intelligence"

HOST="127.0.0.1"
PORT=8000

# ------------------------------------------------------------------------------
# Frontend Configuration (Presentation Tier)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"

