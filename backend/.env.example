# ==============================================================================
# NexLead - Backend Environment Configuration (Template)
# ==============================================================================
PROJECT_NAME="NexLead API"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# CORS Configuration (comma-separated origins allowed to make requests)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Data Tier (MySQL 8.4) Connection Settings
# URL format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL="mysql+pymysql://root:password@127.0.0.1:3306/lead_intelligence"

# Server Execution Settings
HOST="127.0.0.1"
PORT=8000

